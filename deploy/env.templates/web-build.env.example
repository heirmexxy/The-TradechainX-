# → .env at the repo root ON THE SERVER. Docker Compose reads it for the web image build args.
# These end up in the public JavaScript bundle — NO SECRETS here. Change → rebuild the web image.
RELEASE=latest
NEXT_PUBLIC_API_URL=https://api.tradechainx.com
NEXT_PUBLIC_CHAIN_ID=137
# A public, rate-limited RPC URL is fine here (browser reads). Use a separate, domain-restricted key
# if you use a paid provider — never the API's RPC key.
NEXT_PUBLIC_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_WALLET_PROVIDER=privy
NEXT_PUBLIC_GAS_MODE=station
NEXT_PUBLIC_GAS_MIN_BALANCE=0.05
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
NEXT_PUBLIC_SEQUENCE_PROJECT_ACCESS_KEY=
NEXT_PUBLIC_SEQUENCE_WAAS_CONFIG_KEY=
NEXT_PUBLIC_SEQUENCE_NETWORK=
