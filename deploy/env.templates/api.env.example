# PRODUCTION api/indexer environment → deploy/env/api.env on the server (chmod 600).
# Every value marked SECRET comes from the secrets manager. See docs/ACCOUNTS_AND_KEYS.md for how to get each one.
NODE_ENV=production
PORT=4000
PUBLIC_API_URL=https://api.tradechainx.com
WEB_ORIGIN=https://tradechainx.com
PUBLIC_WEB_URL=https://tradechainx.com

# Database (the compose "postgres" service). Password must match postgres.env.  SECRET
DATABASE_URL=postgres://tradechainx:CHANGE_ME@postgres:5432/tradechainx

# Sessions and login codes. Generate each with: openssl rand -base64 48    SECRET
JWT_SECRET=
OTP_PEPPER=

# Chain. Polygon mainnet = 137 (Amoy testnet = 80002). RPC from Alchemy/QuickNode/Infura.   SECRET (URL contains a key)
CHAIN_ID=137
RPC_URL=
INDEXER_CONFIRMATIONS=5
INDEXER_POLL_MS=4000
INDEXER_BATCH_BLOCKS=2000

# Email (SendGrid). Key needs only the "Mail Send" permission.   SECRET
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=no-reply@tradechainx.com
SENDGRID_API_KEY=

# Document storage — S3-compatible. Cloudflare R2 shown; region "auto".   SECRET (keys)
STORAGE_PROVIDER=s3
S3_BUCKET=tradechainx-documents
S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Wallet provider: privy | dynamic | sequence (must match NEXT_PUBLIC_WALLET_PROVIDER).
WALLET_PROVIDER=privy
# RS256 key that signs wallet sign-in tokens. Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out wallet-token.pem
# Store the PEM in the secrets manager; paste here with "\n" for newlines.   SECRET
WALLET_TOKEN_PRIVATE_KEY=
WALLET_TOKEN_KID=tcx-2026-1
WALLET_TOKEN_AUDIENCE=tradechainx-wallet

# Gas station — only until provider gas sponsorship is on. Dedicated hot wallet, small float.   SECRET
GAS_STATION_ENABLED=false
GAS_STATION_KEY=
GAS_STATION_TOP_UP=0.2
GAS_STATION_MIN_BALANCE=0.05
GAS_STATION_COOLDOWN_HOURS=24

# Fiat ramp: none | partner | oms (docs/OMS_INTEGRATION.md).   SECRET (keys)
RAMP_PROVIDER=none
RAMP_API_URL=
RAMP_API_KEY=
RAMP_WEBHOOK_SECRET=
RAMP_CURRENCIES=NGN
RAMP_COUNTRIES=NG

# Partner API. Pepper: openssl rand -base64 48   SECRET
PARTNER_API_ENABLED=false
WEBHOOK_SECRET_PEPPER=

# Health monitor + alerts (docs/PRODUCTION_RUNBOOK.md §9).
HEALTH_CHECK_INTERVAL_SECONDS=60
INDEXER_MAX_LAG_BLOCKS=50
ALERT_EMAILS=ops@tradechainx.com
ALERT_SLACK_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
STATUS_PAGES=

# Must be off in production (the API refuses to start otherwise).
DEV_TOOLS=false
DEV_SHOW_OTP=false
