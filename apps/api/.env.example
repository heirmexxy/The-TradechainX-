# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://tradechainx:tradechainx@localhost:5432/tradechainx

# 32+ random bytes, e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Pepper for hashing one-time login codes. Also random.
OTP_PEPPER=change-me-too-another-long-random-string

CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
INDEXER_CONFIRMATIONS=0
INDEXER_POLL_MS=2000
INDEXER_BATCH_BLOCKS=2000

# Email: "console" logs codes to the API log (dev). "sendgrid" needs SENDGRID_API_KEY + EMAIL_FROM.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@tradechainx.com
SENDGRID_API_KEY=

# Document storage: "local" (dev) or "s3".
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=

# ---- Development-only tools. The server refuses to start in production if these are enabled. ----
DEV_TOOLS=true
# Returns the login code in the API response so you can sign in without email.
DEV_SHOW_OTP=true
# Funds new dev wallets with gas + mock USDC. anvil account 9 (public dev key).
DEV_FAUCET_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
# Must match NEXT_PUBLIC_DEV_WALLET_SEED in apps/web — used by the seed script to know demo wallets.
DEV_WALLET_SEED=tradechainx-local-dev-seed

# ---- S3-compatible storage (Cloudflare R2 / Backblaze B2 / MinIO). Leave empty for AWS S3. ----
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Wallet provider (docs/WALLETS.md): dev | privy | dynamic | sequence ----
WALLET_PROVIDER=dev
# Optional in dev (a temporary key is generated). Required in production.
WALLET_TOKEN_PRIVATE_KEY=
WALLET_TOKEN_KID=
WALLET_TOKEN_AUDIENCE=

# ---- Gas station (interim, until provider gas sponsorship) ----
GAS_STATION_ENABLED=false
GAS_STATION_KEY=
GAS_STATION_TOP_UP=0.2
GAS_STATION_MIN_BALANCE=0.05
GAS_STATION_COOLDOWN_HOURS=24

# ---- Fiat ramp (docs/OMS_INTEGRATION.md): none | partner | oms ----
RAMP_PROVIDER=none
RAMP_API_URL=
RAMP_API_KEY=
RAMP_WEBHOOK_SECRET=
RAMP_CURRENCIES=
RAMP_COUNTRIES=

# ---- Partner API (docs/PARTNER_API.md) ----
PARTNER_API_ENABLED=true
# 32+ random characters; derives webhook signing secrets. Dev value below is public — never reuse it.
WEBHOOK_SECRET_PEPPER=dev-only-webhook-pepper-change-me-0123456789
PUBLIC_WEB_URL=http://localhost:3000

# ---- System health monitor + alerts ----
HEALTH_CHECK_INTERVAL_SECONDS=60
INDEXER_MAX_LAG_BLOCKS=50
ALERT_EMAILS=
ALERT_SLACK_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# JSON list to add/override supplier status pages, e.g. [{"name":"Dynamic","url":"https://…","kind":"http"}]
STATUS_PAGES=
