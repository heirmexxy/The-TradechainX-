# Copy to apps/web/.env.local (dev) — in production these are build-time variables (see docs/PRODUCTION_RUNBOOK.md).
# NEXT_PUBLIC_* values end up in the browser bundle: never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# ---- Wallet provider (docs/WALLETS.md) ----
# dev | privy | dynamic | sequence. Must match WALLET_PROVIDER in the API env.
NEXT_PUBLIC_WALLET_PROVIDER=dev
# How gas is paid: sponsored (provider paymaster) | station (API gas station tops up) | none.
# Defaults: "none" for dev, "station" otherwise.
NEXT_PUBLIC_GAS_MODE=
NEXT_PUBLIC_GAS_MIN_BALANCE=0.05

# dev — local key derived in the browser. DEVELOPMENT ONLY; refused in production builds.
NEXT_PUBLIC_DEV_WALLET_SEED=tradechainx-local-dev-seed

# privy — dashboard.privy.io → App settings → App ID
NEXT_PUBLIC_PRIVY_APP_ID=

# dynamic — app.dynamic.xyz → Developers → SDK & API keys → Environment ID
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# sequence — sequence.build → project → Embedded Wallet
NEXT_PUBLIC_SEQUENCE_PROJECT_ACCESS_KEY=
NEXT_PUBLIC_SEQUENCE_WAAS_CONFIG_KEY=
NEXT_PUBLIC_SEQUENCE_NETWORK=
